{
  "name": "@voxaflow/web-core",
  "version": "0.1.0",
  "description": "Voxa Flow Web SDK core — framework-agnostic client wrapping livekit-client + the Voxa realtime/REST API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1"
  },
  "peerDependencies": {
    "livekit-client": "^2.5.0",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "livekit-client": "^2.5.0",
    "socket.io-client": "^4.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
